# Copy this file to `.env` (same folder as manage.py) and fill in real values.
# `.env` is gitignored; this example is safe to commit.

# --- Core ---
# DEBUG=False in production.
DEBUG=True
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
# Comma-separated hostnames. Required when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Google OAuth (social login) ---
# From Google Cloud Console > Credentials > OAuth 2.0 Client IDs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Paystack (payments) ---
# Use sk_test_/pk_test_ for development, sk_live_/pk_live_ in production.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
